# Copy to .env and fill in. Never commit .env, and never put these keys in the frontend.

# Gemini (Gill Gates). Fallback is used when the main model is busy or rate-limited; set it to "" to turn off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ElevenLabs voice (optional). The default voice id is a placeholder premade voice; pick a fishier one.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Capital One Nessie sandbox (mock bank data)
NESSIE_API_KEY=

# Bowl Street market data. Keep this key on the backend only.
TWELVE_DATA_API_KEY=
# Match your purchased plan's actual API credits/minute. Full US-market ranking
# runs hourly; each scan needs (US stock count) + 60 credits in its minute.
# The free plan (8/minute, 800/day) cannot support that scan.
TWELVE_DATA_CREDITS_PER_MINUTE=8

DB_PATH=app.db

# Extra frontend origins can be allowed by overriding this regex (default: localhost + Lovable)
# CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+|https://[a-z0-9-]+\.lovable\.app|https://[a-z0-9-]+\.lovableproject\.com

# How long an idle Gill chat (and its "this chat" permissions) is kept
ASSISTANT_SESSION_TTL_HOURS=24
